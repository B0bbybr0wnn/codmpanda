rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'ItqEYihqxYW4HGm7i8bBYky8XNw1';
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isProUserData(data) {
      return data.get('isPro', false) == true || data.get('proStatus', '') == 'active';
    }

    function isFreeAvatarFrame(frame) {
      return frame is string && frame in [
        'none', 'shadow_legion', 'cosmic_vanguard', 'weapon_master', 'ice_crystal',
        'battle_hardened', 'sharpshooter', 'urban_warrior', 'chemical_warfare',
        'war_trophy_skulls', 'war_machine'
      ];
    }

    function isProAvatarFrame(frame) {
      return frame is string && frame in [
        'ghost_ops', 'mythic_crystal', 'inferno', 'frost_division', 'legendary_rank',
        'zombie_hunter', 'dragon_blade', 'war_trophy', 'ranked_champion', 'task_force'
      ];
    }

    function isAllowedAvatarFrame(frame, allowPro) {
      return isFreeAvatarFrame(frame) || (allowPro && isProAvatarFrame(frame));
    }

    function createdProfileFramesAllowed() {
      return (!('avatarFrame' in request.resource.data) || isFreeAvatarFrame(request.resource.data.avatarFrame))
        && (!('equippedAvatarFrame' in request.resource.data) || isFreeAvatarFrame(request.resource.data.equippedAvatarFrame))
        && (!('equippedFrame' in request.resource.data) || isFreeAvatarFrame(request.resource.data.equippedFrame))
        && (!('selectedFrame' in request.resource.data) || isFreeAvatarFrame(request.resource.data.selectedFrame))
        && (!('frameId' in request.resource.data) || isFreeAvatarFrame(request.resource.data.frameId))
        && (!('frame' in request.resource.data) || isFreeAvatarFrame(request.resource.data.frame))
        && (!('profileFrame' in request.resource.data) || isFreeAvatarFrame(request.resource.data.profileFrame));
    }

    function changedProfileFramesAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let allowPro = isProUserData(resource.data);
      return (!changed.hasAny(['avatarFrame']) || isAllowedAvatarFrame(request.resource.data.get('avatarFrame', 'none'), allowPro))
        && (!changed.hasAny(['equippedAvatarFrame']) || isAllowedAvatarFrame(request.resource.data.get('equippedAvatarFrame', 'none'), allowPro))
        && (!changed.hasAny(['equippedFrame']) || isAllowedAvatarFrame(request.resource.data.get('equippedFrame', 'none'), allowPro))
        && (!changed.hasAny(['selectedFrame']) || isAllowedAvatarFrame(request.resource.data.get('selectedFrame', 'none'), allowPro))
        && (!changed.hasAny(['frameId']) || isAllowedAvatarFrame(request.resource.data.get('frameId', 'none'), allowPro))
        && (!changed.hasAny(['frame']) || isAllowedAvatarFrame(request.resource.data.get('frame', 'none'), allowPro))
        && (!changed.hasAny(['profileFrame']) || isAllowedAvatarFrame(request.resource.data.get('profileFrame', 'none'), allowPro));
    }

    function watchlistUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let newList = request.resource.data.get('metaWatchlist', []);
      let oldList = resource.data.get('metaWatchlist', []);
      return !changed.hasAny(['metaWatchlist'])
        || (newList is list
            && (newList.size() <= 3
                || (isProUserData(resource.data) && newList.size() <= 100)
                || newList.size() < oldList.size()));
    }

    function ownerUpdatesSentRequests(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldSent = resource.data.get('friendRequestsSent', []);
      let newSent = request.resource.data.get('friendRequestsSent', []);
      return isOwner(userId)
        && changed.hasOnly(['friendRequestsSent'])
        && oldSent is list && newSent is list
        && ((newSent.size() == oldSent.size() + 1 && newSent.hasAll(oldSent))
          || (oldSent.size() == newSent.size() + 1 && oldSent.hasAll(newSent)));
    }

    function anotherUserAddsIncomingRequest(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldRequests = resource.data.get('friendRequests', []);
      let newRequests = request.resource.data.get('friendRequests', []);
      return isSignedIn() && request.auth.uid != userId
        && changed.hasOnly(['friendRequests'])
        && oldRequests is list && newRequests is list
        && !oldRequests.hasAny([request.auth.uid])
        && newRequests.hasAny([request.auth.uid])
        && newRequests.size() == oldRequests.size() + 1
        && newRequests.hasAll(oldRequests);
    }

    function incomingRequestIsRemoved(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldRequests = resource.data.get('friendRequests', []);
      let newRequests = request.resource.data.get('friendRequests', []);
      return isSignedIn()
        && changed.hasOnly(['friendRequests'])
        && oldRequests is list && newRequests is list
        && oldRequests.size() == newRequests.size() + 1
        && oldRequests.hasAll(newRequests)
        && (isOwner(userId)
          || (request.auth.uid != userId
            && oldRequests.hasAny([request.auth.uid])
            && !newRequests.hasAny([request.auth.uid])));
    }

    function ownerAcceptsIncomingRequest(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldFriends = resource.data.get('friends', []);
      let newFriends = request.resource.data.get('friends', []);
      let oldRequests = resource.data.get('friendRequests', []);
      let newRequests = request.resource.data.get('friendRequests', []);
      return isOwner(userId)
        && changed.hasAll(['friends', 'friendRequests'])
        && changed.hasOnly(['friends', 'friendRequests'])
        && oldFriends is list && newFriends is list
        && oldRequests is list && newRequests is list
        && newFriends.size() == oldFriends.size() + 1
        && newFriends.hasAll(oldFriends)
        && newFriends.hasAny(oldRequests)
        && oldRequests.size() == newRequests.size() + 1
        && oldRequests.hasAll(newRequests);
    }

    function acceptedRequesterProfileUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldSent = resource.data.get('friendRequestsSent', []);
      let newSent = request.resource.data.get('friendRequestsSent', []);
      let oldFriends = resource.data.get('friends', []);
      let newFriends = request.resource.data.get('friends', []);
      return isSignedIn() && request.auth.uid != userId
        && changed.hasAll(['friends', 'friendRequestsSent'])
        && changed.hasOnly(['friends', 'friendRequestsSent'])
        && oldSent is list && newSent is list
        && oldFriends is list && newFriends is list
        && oldSent.hasAny([request.auth.uid])
        && !newSent.hasAny([request.auth.uid])
        && oldSent.size() == newSent.size() + 1
        && oldSent.hasAll(newSent)
        && newFriends.size() == oldFriends.size() + 1
        && newFriends.hasAll(oldFriends)
        && newFriends.hasAny([request.auth.uid]);
    }

    function ownerRemovesFriend(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldFriends = resource.data.get('friends', []);
      let newFriends = request.resource.data.get('friends', []);
      return isOwner(userId)
        && changed.hasOnly(['friends'])
        && oldFriends is list && newFriends is list
        && oldFriends.size() == newFriends.size() + 1
        && oldFriends.hasAll(newFriends);
    }

    function anotherUserRemovesSelfAsFriend(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldFriends = resource.data.get('friends', []);
      let newFriends = request.resource.data.get('friends', []);
      return isSignedIn() && request.auth.uid != userId
        && changed.hasOnly(['friends'])
        && oldFriends is list && newFriends is list
        && oldFriends.hasAny([request.auth.uid])
        && !newFriends.hasAny([request.auth.uid])
        && oldFriends.size() == newFriends.size() + 1
        && oldFriends.hasAll(newFriends);
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId)
        && (!('isPro' in request.resource.data) || request.resource.data.isPro == false)
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
        && createdProfileFramesAllowed()
        && (!('metaWatchlist' in request.resource.data)
            || (request.resource.data.get('metaWatchlist', []) is list
                && request.resource.data.get('metaWatchlist', []).size() <= 3));
      allow update: if isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['banned','banReason','bannedAt','bannedBy','isPro','isAdmin','role','proExpiresAt','proStatus','verified','verifiedAt','friendRequests','friendRequestsSent','friends'])
            && changedProfileFramesAllowed()
            && watchlistUpdateAllowed())
        || ownerUpdatesSentRequests(userId)
        || anotherUserAddsIncomingRequest(userId)
        || incomingRequestIsRemoved(userId)
        || ownerAcceptsIncomingRequest(userId)
        || acceptedRequesterProfileUpdate(userId)
        || ownerRemovesFriend(userId)
        || anotherUserRemovesSelfAsFriend(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    function lobbyMemberJoinAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldMembers = resource.data.get('memberUids', []);
      let newMembers = request.resource.data.get('memberUids', []);
      let oldPlayers = resource.data.get('players', 1);
      let newPlayers = request.resource.data.get('players', oldPlayers);
      return isSignedIn()
        && changed.hasOnly(['players', 'memberUids'])
        && oldMembers is list
        && newMembers is list
        && newMembers.size() <= 5
        && newMembers.hasAll(oldMembers)
        && newMembers.hasAny([request.auth.uid])
        && !(request.auth.uid in resource.data.get('removedMemberUids', []))
        && newPlayers == oldPlayers + 1
        && (
          newMembers.size() == oldMembers.size() + 1
          || (!('memberUids' in resource.data)
            && oldMembers.size() == 0
            && newMembers.size() == 2
            && newMembers.hasAny([resource.data.get('uid', '')])
            && newMembers.hasAny([request.auth.uid]))
        );
    }

    match /lobbies/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players','isPro','reactions'])
        || lobbyMemberJoinAllowed()
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /vaults/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','reactions'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /camos/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    function clanMembershipUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldMembers = resource.data.get('members', []);
      let newMembers = request.resource.data.get('members', []);
      return isSignedIn()
        && changed.hasOnly(['members'])
        && oldMembers is list && newMembers is list
        && newMembers.size() <= 50
        && (
          resource.data.ownerUid == request.auth.uid
          || (
            newMembers.size() == oldMembers.size() + 1
            && newMembers.hasAll(oldMembers)
            && newMembers.hasAny([request.auth.uid])
            && !oldMembers.hasAny([request.auth.uid])
          )
          || (
            oldMembers.size() == newMembers.size() + 1
            && oldMembers.hasAll(newMembers)
            && oldMembers.hasAny([request.auth.uid])
            && !newMembers.hasAny([request.auth.uid])
          )
        );
    }

    match /clans/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.ownerUid == request.auth.uid
        || clanMembershipUpdateAllowed()
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }

    match /clips/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','reactions'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /leaks/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hypes','reactions'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /posts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','commentCount','reactions'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /comments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','reactions'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /likes/{id} {
      allow read: if isSignedIn();
      // A signed-in user may save any reaction offered by the UI. Keep the
      // reaction value verbatim; premium gating belongs in the UI, not here.
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('reaction', '') is string
        && request.resource.data.get('reaction', '').size() > 0;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /notifications/{id} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /messages/{id} {
      allow get: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
      );
    }

    match /hashtags/{tagId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.tag is string
        && request.resource.data.count == 1;
      allow update: if isSignedIn()
        && request.resource.data.tag == resource.data.tag
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}