rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'ItqEYihqxYW4HGm7i8bBYky8XNw1';
    }

    // ---------- USERS ----------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
                    && request.resource.data.isPro == false
                    && request.resource.data.ign is string
                    && request.resource.data.ign.size() >= 2
                    && request.resource.data.ign.size() <= 24;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(uid) && (
          request.resource.data.isPro == resource.data.isPro
          && request.resource.data.proExpiry == resource.data.proExpiry
        )) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAvg', 'ratingCount', 'ratingTags']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends', 'friendRequests', 'friendRequestsSent']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentParty']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tournamentWins'])
      );
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- LOBBIES ----------
    match /lobbies/{lobbyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.players >= 1
                    && request.resource.data.players <= 5;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- VAULTS ----------
    match /vaults/{vaultId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.likes == 0
                    && request.resource.data.type in ['gunsmith', 'sens', 'hud'];
      allow update: if isSignedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
        || (resource.data.uid == request.auth.uid)
        || isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- CAMOS ----------
    match /camos/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ---------- CLANS ----------
    match /clans/{clanId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 3
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 1;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ---------- SCRIMS ----------
    match /scrims/{scrimId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500;
      allow update, delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- CLIPS ----------
    match /clips/{clipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.youtubeUrl is string
                    && request.resource.data.likes == 0;
      allow update: if isSignedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
        || (resource.data.uid == request.auth.uid)
        || isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- LEAKS ----------
    match /leaks/{leakId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------- SUBMISSIONS ----------
    match /leak_submissions/{subId} {
      allow create: if isSignedIn()
                    && request.resource.data.submitterUid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    match /vault_submissions/{subId} {
      allow create: if isSignedIn()
                    && request.resource.data.submitterUid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    match /clip_submissions/{subId} {
      allow create: if isSignedIn()
                    && request.resource.data.submitterUid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // ---------- REPORTS ----------
    match /reports/{reportId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ---------- TIER VOTES ----------
    match /tierVotes/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ---------- RATINGS ----------
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- CLAN WARS ----------
    match /clanWarsLog/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /clanWarsHistory/{historyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------- TOURNAMENTS ----------
    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.creatorUid == request.auth.uid || isAdmin());
    }

    match /tournamentHistory/{historyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // ---------- MESSAGES (DMs) ----------
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.fromUid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.fromUid == request.auth.uid || isAdmin());
    }

    // ---------- PARTIES ----------
    match /parties/{partyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.leaderUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.leaderUid == request.auth.uid || isAdmin());
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{notifId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // ---------- COMMENTS ----------
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 300;
      allow update: if isSignedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
        || (resource.data.uid == request.auth.uid)
        || isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- LIKES ----------
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ---------- DEFAULT DENY ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
