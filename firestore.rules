rules_version = '2';

// ============================================
// CODMPanda — Firestore Security Rules
// ============================================
// Philosophy:
//   - Authenticated users can read most content
//   - Users can only write their own content
//   - Narrow cross-user writes: counters, arrays, friend requests
//   - Admin (ADMIN_UID) can do anything
//   - Banned users are locked out of creates
// ============================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPERS
    // ============================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.uid == 'ItqEYihqxYW4HGm7i8bBYky8XNw1';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Cheap ban check — only called on creates, not reads.
    // Costs 1 read per invocation. Skip on likes to save quota.
    function isNotBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned;
    }

    // ============================================
    // USERS
    // ============================================
    match /users/{userId} {
      // Anyone signed in can read profiles (privacy handled client-side)
      allow read: if isSignedIn();

      // Users can create their own profile
      allow create: if isOwner(userId);

      // Users can update their own profile.
      // They CANNOT self-escalate: banned, isPro, proExpiry, approvedCount, badges
      // are locked. Admin can always edit.
      // Cross-user writes are allowed ONLY for friend request arrays.
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'banned', 'banReason', 'bannedAt', 'bannedBy',
                'isPro', 'proExpiry', 'proFromContribution',
                'approvedCount', 'badges',
                'verified', 'verifiedAt',
                'tournamentWins', 'activeStreak', 'lastActiveDate'
              ])
        )
        || (
          // Narrow: anyone can add themselves to friend arrays
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['friendRequests', 'friendRequestsSent'])
        );

      // Owner can delete their own account; admin can delete anyone
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ============================================
    // LOBBIES (LFG)
    // ============================================
    match /lobbies/{lobbyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      // Owner edits anything; anyone can bump `players` (join);
      // owner can also set isPro after posting.
      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['players'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // VAULTS (Gunsmith / Sens / HUD)
    // ============================================
    match /vaults/{vaultId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // CAMOS (per-user tracker)
    // ============================================
    match /camos/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ============================================
    // CLANS
    // ============================================
    match /clans/{clanId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      // Owner edits everything; anyone can join/leave via members array
      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.ownerUid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.ownerUid == request.auth.uid
      );
    }

    // ============================================
    // SCRIMS
    // ============================================
    match /scrims/{scrimId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();
      allow update, delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // CLIPS
    // ============================================
    match /clips/{clipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // LEAKS
    // ============================================
    match /leaks/{leakId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hypes'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // POSTS (home feed)
    // ============================================
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      // Owner edits text; anyone can bump likes; owner can update commentCount
      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'commentCount'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // COMMENTS (on posts, vaults, clips, leaks, lobbies)
    // ============================================
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      // Owner edits text; anyone can bump likes
      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // LIKES (doc ID: {itemType}_{itemId}_{userId})
    // Users can create/update/delete ONLY their own like doc.
    // ============================================
    match /likes/{likeId} {
      allow read: if isSignedIn();

      // Write = create + update + delete. Using `write` here so
      // rapid double-taps that turn into setDoc-update don't fail.
      allow write: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    // ============================================
    // NOTIFICATIONS
    // ============================================
    // Special: needs `list` rules because the client queries with
    // where('userId', '==', uid). Reads of individual docs use `get`.
    match /notifications/{notifId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow list: if isSignedIn()
        && request.query.filters.containsKey('userId')
        && request.query.filters.userId[1] == request.auth.uid;

      // Anyone signed in can create notifications for others (system messages)
      allow create: if isSignedIn();

      // Only recipient can mark read
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ============================================
    // MESSAGES (DMs)
    // ============================================
    // Special: needs `list` rules because the client queries by
    // fromUid OR toUid. Without these, the DM inbox fails silently.
    match /messages/{messageId} {
      allow get: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
      );

      allow list: if isSignedIn() && (
        (request.query.filters.containsKey('fromUid')
          && request.query.filters.fromUid[1] == request.auth.uid)
        || (request.query.filters.containsKey('toUid')
          && request.query.filters.toUid[1] == request.auth.uid)
      );

      allow create: if isSignedIn()
        && isNotBanned()
        && request.resource.data.fromUid == request.auth.uid;

      allow update, delete: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid || isAdmin()
      );
    }

    // ============================================
    // REPORTS
    // ============================================
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isNotBanned();
      allow update, delete: if isAdmin();
    }

    // ============================================
    // TOURNAMENTS
    // ============================================
    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      // Creator edits everything; anyone can register (teams array)
      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.creatorUid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['teams'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.creatorUid == request.auth.uid
      );
    }

    // ============================================
    // CLAN WARS
    // ============================================
    match /clanWarsLog/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /clanWarsHistory/{historyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ============================================
    // SUBMISSIONS (legacy — kept for backward compat)
    // ============================================
    match /vault_submissions/{subId} {
      allow read: if isSignedIn() && (
        resource.data.submitterUid == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && isNotBanned();
      allow update, delete: if isAdmin();
    }

    match /leak_submissions/{subId} {
      allow read: if isSignedIn() && (
        resource.data.submitterUid == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && isNotBanned();
      allow update, delete: if isAdmin();
    }

    match /clip_submissions/{subId} {
      allow read: if isSignedIn() && (
        resource.data.submitterUid == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && isNotBanned();
      allow update, delete: if isAdmin();
    }

    // ============================================
    // PARTIES (voice room groups)
    // ============================================
    match /parties/{partyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();

      // Leader edits; anyone can join/leave via members array
      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.leaderUid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.leaderUid == request.auth.uid
      );
    }

    // ============================================
    // TIER VOTES (one doc per user)
    // ============================================
    match /tierVotes/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
