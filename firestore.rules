rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- HELPERS ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'ItqEYihqxYW4HGm7i8bBYky8XNw1';
    }

    // ---------- USERS ----------
    match /users/{uid} {
      allow read: if isSignedIn();

      // Create — owner only, cannot self-grant Pro
      allow create: if isOwner(uid)
                    && request.resource.data.isPro == false
                    && request.resource.data.ign is string
                    && request.resource.data.ign.size() >= 2
                    && request.resource.data.ign.size() <= 24;

      // Update — owner can edit their own profile EXCEPT isPro/proExpiry
      // Only admin can flip those (or in future: server-side webhook from payment provider)
      allow update: if isOwner(uid) && (
        isAdmin() ||
        (request.resource.data.isPro == resource.data.isPro
         && request.resource.data.proExpiry == resource.data.proExpiry)
      );

      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- LOBBIES (LFG) ----------
    match /lobbies/{lobbyId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.players is number
                    && request.resource.data.players >= 1
                    && request.resource.data.players <= 5;

      // Anyone signed in can update (join increments players)
      allow update: if isSignedIn();

      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- VAULTS ----------
    match /vaults/{vaultId} {
      allow read: if true; // Public — shareable links work without login

      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.likes == 0
                    && request.resource.data.type in ['gunsmith', 'sens', 'hud'];

      // Anyone signed in can update likes; owner can edit their vault
      allow update: if isSignedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
        ||
        (resource.data.uid == request.auth.uid)
        ||
        isAdmin()
      );

      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- CAMOS ----------
    match /camos/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ---------- CLANS ----------
    match /clans/{clanId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 3
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 1;

      // Owner or members can update (join/leave)
      allow update: if isSignedIn();

      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ---------- SCRIMS ----------
    match /scrims/{scrimId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500;

      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- CLIPS ----------
    match /clips/{clipId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.youtubeUrl is string
                    && request.resource.data.likes == 0;

      // Anyone can like; owner can edit; admin can do anything
      allow update: if isSignedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
        ||
        (resource.data.uid == request.auth.uid)
        ||
        isAdmin()
      );

      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- LEAKS (ADMIN ONLY WRITES) ----------
    match /leaks/{leakId} {
      allow read: if isSignedIn();

      // Only admin can post/edit/delete leaks
      allow create, update, delete: if isAdmin();
    }

    // ---------- REPORTS (ANYONE CAN CREATE, ADMIN ONLY MANAGE) ----------
    match /reports/{reportId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ---------- TIER VOTES ----------
    match /tierVotes/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ---------- DEFAULT DENY ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
