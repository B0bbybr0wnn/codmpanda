rules_version = '2';

// ============================================
// CODMPanda — Firestore Security Rules
// ============================================
// Philosophy:
//   - Authenticated users can read most content
//   - Users can only write their own content
//   - Narrow cross-user writes: counters, arrays, friend requests
//   - Admin (ADMIN_UID) can do anything
//   - Banned users are locked out of creates
// ============================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPERS
    // ============================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.uid == 'ItqEYihqxYW4HGm7i8bBYky8XNw1';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Cheap ban check — only called on creates, not reads.
    // Costs 1 read per invocation. Skip on likes to save quota.
    function isNotBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned;
    }

    // ============================================
    // USERS
    // ============================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'banned', 'banReason', 'bannedAt', 'bannedBy',
                'isPro', 'proExpiry', 'proFromContribution',
                'approvedCount', 'badges',
                'verified', 'verifiedAt',
                'tournamentWins', 'activeStreak', 'lastActiveDate'
              ])
        )
        || (
          // Narrow: anyone can add themselves to friend arrays
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['friendRequests', 'friendRequestsSent'])
        );

      allow delete: if isOwner(userId) || isAdmin();
    }

    // ============================================
    // LOBBIES (LFG)
    // ============================================
    match /lobbies/{lobbyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['players', 'isPro'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // VAULTS (Gunsmith / Sens / HUD)
    // ============================================
    match /vaults/{vaultId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // CAMOS (per-user tracker)
    // ============================================
    match /camos/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ============================================
    // CLANS
    // ============================================
    match /clans/{clanId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.ownerUid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.ownerUid == request.auth.uid
      );
    }

    // ============================================
    // SCRIMS
    // ============================================
    match /scrims/{scrimId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();
      allow update, delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // CLIPS
    // ============================================
    match /clips/{clipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // LEAKS
    // ============================================
    match /leaks/{leakId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hypes'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // POSTS (home feed)
    // ============================================
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'commentCount'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // COMMENTS
    // ============================================
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
    }

    // ============================================
    // LIKES
    // ============================================
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    // ============================================
    // NOTIFICATIONS
    // ============================================
    match /notifications/{notifId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow list: if isSignedIn()
        && request.query.filters.containsKey('userId')
        && request.query.filters.userId[1] == request.auth.uid;

      allow create: if isSignedIn();

      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ============================================
    // MESSAGES (DMs)
    // ============================================
    match /messages/{messageId} {
      allow get: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
      );

      allow list: if isSignedIn() && (
        (request.query.filters.containsKey('fromUid')
          && request.query.filters.fromUid[1] == request.auth.uid)
        || (request.query.filters.containsKey('toUid')
          && request.query.filters.toUid[1] == request.auth.uid)
      );

      allow create: if isSignedIn()
        && isNotBanned()
        && request.resource.data.fromUid == request.auth.uid;

      allow update, delete: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid || isAdmin()
      );
    }

    // ============================================
    // REPORTS
    // ============================================
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isNotBanned();
      allow update, delete: if isAdmin();
    }

    // ============================================
    // TOURNAMENTS
    // ============================================
    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned();

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.creatorUid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['teams', 'bracket', 'currentRound', 'status', 'winner', 'completedAt'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.creatorUid == request.auth.uid
      );
    }

    // ============================================
    // CLAN WARS
    // ============================================
    match /clanWarsLog/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /clanWarsHistory/{historyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ============================================
    // SUBMISSIONS (legacy)
    // ============================================
    match /vault_submissions/{subId} {
      allow read: if isSignedIn() && (
        resource.data.submitterUid == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && isNotBanned();
      allow update, delete: if isAdmin();
    }

    match /leak_submissions/{subId} {
      allow read: if isSignedIn() && (
        resource.data.submitterUid == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && isNotBanned();
      allow update, delete: if isAdmin();
    }

    match /clip_submissions/{subId} {
      allow read: if isSignedIn() && (
        resource.data.submitterUid == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && isNotBanned();
      allow update, delete: if isAdmin();
    }

    // ============================================
    // PARTIES
    // ============================================
    match /parties/{partyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.leaderUid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.leaderUid == request.auth.uid
      );
    }

    // ============================================
    // TIER VOTES
    // ============================================
    match /tierVotes/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ============================================
    // RATINGS (LFG reputation)
    // ============================================
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned()
        && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || resource.data.fromUid == request.auth.uid;
    }

    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
