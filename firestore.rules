rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'ItqEYihqxYW4HGm7i8bBYky8XNw1';
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isProUserData(data) {
      return data.get('isPro', false) == true || data.get('proStatus', '') == 'active';
    }

    function isFreeAvatarFrame(frame) {
      return frame is string && frame in [
        'none', 'shadow_legion', 'cosmic_vanguard', 'weapon_master', 'ice_crystal',
        'battle_hardened', 'sharpshooter', 'urban_warrior', 'chemical_warfare',
        'war_trophy_skulls', 'war_machine'
      ];
    }

    function isProAvatarFrame(frame) {
      return frame is string && frame in [
        'ghost_ops', 'mythic_crystal', 'inferno', 'frost_division', 'legendary_rank',
        'zombie_hunter', 'dragon_blade', 'war_trophy', 'ranked_champion', 'task_force'
      ];
    }

    function isAllowedAvatarFrame(frame, allowPro) {
      return isFreeAvatarFrame(frame) || (allowPro && isProAvatarFrame(frame));
    }

    // New profiles are Free by default, so every frame alias supplied at creation
    // must be one of the canonical Free IDs (or "none").
    function createdProfileFramesAllowed() {
      return (!('avatarFrame' in request.resource.data) || isFreeAvatarFrame(request.resource.data.avatarFrame))
        && (!('equippedAvatarFrame' in request.resource.data) || isFreeAvatarFrame(request.resource.data.equippedAvatarFrame))
        && (!('equippedFrame' in request.resource.data) || isFreeAvatarFrame(request.resource.data.equippedFrame))
        && (!('selectedFrame' in request.resource.data) || isFreeAvatarFrame(request.resource.data.selectedFrame))
        && (!('frameId' in request.resource.data) || isFreeAvatarFrame(request.resource.data.frameId))
        && (!('frame' in request.resource.data) || isFreeAvatarFrame(request.resource.data.frame))
        && (!('profileFrame' in request.resource.data) || isFreeAvatarFrame(request.resource.data.profileFrame));
    }

    // The current picker writes the same canonical ID to all aliases. Validate each
    // changed alias so authenticated users cannot grant themselves a Pro-only frame.
    function changedProfileFramesAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let allowPro = isProUserData(resource.data);
      return (!changed.hasAny(['avatarFrame']) || isAllowedAvatarFrame(request.resource.data.get('avatarFrame', 'none'), allowPro))
        && (!changed.hasAny(['equippedAvatarFrame']) || isAllowedAvatarFrame(request.resource.data.get('equippedAvatarFrame', 'none'), allowPro))
        && (!changed.hasAny(['equippedFrame']) || isAllowedAvatarFrame(request.resource.data.get('equippedFrame', 'none'), allowPro))
        && (!changed.hasAny(['selectedFrame']) || isAllowedAvatarFrame(request.resource.data.get('selectedFrame', 'none'), allowPro))
        && (!changed.hasAny(['frameId']) || isAllowedAvatarFrame(request.resource.data.get('frameId', 'none'), allowPro))
        && (!changed.hasAny(['frame']) || isAllowedAvatarFrame(request.resource.data.get('frame', 'none'), allowPro))
        && (!changed.hasAny(['profileFrame']) || isAllowedAvatarFrame(request.resource.data.get('profileFrame', 'none'), allowPro));
    }

    function watchlistUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let newList = request.resource.data.get('metaWatchlist', []);
      let oldList = resource.data.get('metaWatchlist', []);
      return !changed.hasAny(['metaWatchlist'])
        || (newList is list
            && (newList.size() <= 3
                || (isProUserData(resource.data) && newList.size() <= 100)
                || newList.size() < oldList.size()));
    }

    // ---------- USERS ----------
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId)
        && (!('isPro' in request.resource.data) || request.resource.data.isPro == false)
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
        // New Free profiles cannot initialise with a Pro-only frame.
        && createdProfileFramesAllowed()
        && (!('metaWatchlist' in request.resource.data)
            || (request.resource.data.get('metaWatchlist', []) is list
                && request.resource.data.get('metaWatchlist', []).size() <= 3));
      allow update: if isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['banned','banReason','bannedAt','bannedBy','isPro','isAdmin','role','proExpiresAt','proStatus','verified','verifiedAt'])
            && changedProfileFramesAllowed()
            && watchlistUpdateAllowed())
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['friendRequests','friendRequestsSent','friends']));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ---------- LOBBIES ----------
    match /lobbies/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players','isPro','reactions'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    // ---------- VAULTS ----------
    match /vaults/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','reactions'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    // ---------- CAMOS ----------
    match /camos/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ---------- CLANS ----------
    match /clans/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.ownerUid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }

    // ---------- SCRIMS ----------
    match /scrims/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    // ---------- CLIPS ----------
    match /clips/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','reactions'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    // ---------- LEAKS ----------
    match /leaks/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hypes','reactions'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    // ---------- POSTS ----------
    match /posts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','commentCount','reactions'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    // ---------- COMMENTS ----------
    match /comments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','reactions'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    // ---------- LIKES / REACTIONS ----------
    match /likes/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (!(request.resource.data.get('reaction', '') in ['goat', 'crown'])
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPro == true);
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{id} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Queries must include where('userId', '==', request.auth.uid).
      // Rules evaluate each returned document; no unsupported query.filters access.
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ---------- MESSAGES ----------
    match /messages/{id} {
      allow get: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      // Query results must be limited to messages involving the signed-in user.
      // DM screens query chatId together with fromUid/toUid, so both participants
      // can read the same thread without exposing other users' messages.
      allow list: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.fromUid == request.auth.uid || isAdmin());
    }

    // ---------- REPORTS ----------
    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ---------- TOURNAMENTS ----------
    match /tournaments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.creatorUid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teams','bracket','currentRound','status','winner','completedAt'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.creatorUid == request.auth.uid);
    }

    // ---------- CLAN WARS ----------
    match /clanWarsLog/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /clanWarsHistory/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- SUBMISSIONS ----------
    match /vault_submissions/{id} {
      allow read: if isSignedIn() && (resource.data.submitterUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /leak_submissions/{id} {
      allow read: if isSignedIn() && (resource.data.submitterUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /clip_submissions/{id} {
      allow read: if isSignedIn() && (resource.data.submitterUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ---------- PARTIES ----------
    match /parties/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.leaderUid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.leaderUid == request.auth.uid);
    }

    // ---------- CODMPANDA INTEL ARTICLES ----------
    // Curated briefings are readable by authenticated users. Only the configured admin
    // can publish, edit, or remove articles; users cannot self-publish news.
    match /intelArticles/{articleId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 12;
      allow update, delete: if isAdmin();
    }

    // ---------- TIER VOTES ----------
    match /tierVotes/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ---------- RATINGS ----------
    match /ratings/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isAdmin() || resource.data.fromUid == request.auth.uid;
    }

    // ---------- DEFAULT DENY ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
